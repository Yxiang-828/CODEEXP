{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Login username"
    },
    "display_name": {
      "type": "string",
      "description": "Full display name"
    },
    "password": {
      "type": "string",
      "description": "Plain text password for demo"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "primary_role": {
      "type": "string",
      "enum": [
        "civilian",
        "responder",
        "operations"
      ],
      "description": "Primary role of the user"
    },
    "secondary_role": {
      "type": "string",
      "enum": [
        "civilian",
        "none"
      ],
      "default": "none",
      "description": "Secondary role - civilian for responder/ops, none for civilians"
    },
    "active_role": {
      "type": "string",
      "enum": [
        "civilian",
        "responder",
        "operations"
      ],
      "description": "Currently active role (can switch if has secondary)"
    },
    "address": {
      "type": "string",
      "description": "Home address in Singapore"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relevant skills like First Aid, CPR etc"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user is currently available for duty"
    }
  },
  "required": [
    "username",
    "display_name",
    "password",
    "primary_role"
  ]
}